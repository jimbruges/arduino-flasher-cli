+
+/* Storage digests are distinct from VIP transport digest tables. */
+struct storage_digest {
+    char hex[65];
+    bool invalid;
+};
 
+static int firehose_digest_parser(xmlNode *node, void *data, bool *rawmode)
+{
+    struct storage_digest *digest = data;
+    xmlChar *value = xmlGetProp(node, (xmlChar *)"value");
+    if (value && !xmlStrcmp(node->name, (xmlChar *)"log")) {
+        const char *start = strstr((const char *)value, "Digest ");
+        if (start) {
+            start += 7;
+            if (digest->hex[0] || strlen(start) != 64 ||
+                strspn(start, "0123456789abcdefABCDEF") != 64)
+                digest->invalid = true;
+            else
+                memcpy(digest->hex, start, 65);
+        }
+    }
+    xmlFree(value);
+    return firehose_generic_parser(node, NULL, rawmode);
+}
